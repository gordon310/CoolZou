<view class="page">
  <text class="eyebrow">内容确认</text>
  <view class="page-title">检查每一页</view>
  <view wx:if="{{error}}" class="notice">{{error}}</view>
  <view wx:if="{{deck}}">
    <view class="section"><text class="section-title">{{deck.title}}</text><text class="hint">{{deck.grade}}年级 · {{deck.gender === 'boy' ? '男孩' : '女孩'}} · {{deck.stage}}</text></view>
    <view class="slide" wx:for="{{deck.slides}}" wx:key="index">
      <text class="slide-number">{{index + 1 < 10 ? '0' : ''}}{{index + 1}}</text>
      <label class="field">页标题<textarea class="textarea compact" disabled="{{deck.pipeline === 2 && deck.phase === 'full' && index < 5}}" maxlength="40" value="{{item.title}}" data-index="{{index}}" data-field="title" bindinput="edit" /></label>
      <label class="field">页面正文<textarea class="textarea compact" disabled="{{deck.pipeline === 2 && deck.phase === 'full' && index < 5}}" maxlength="180" value="{{item.body}}" data-index="{{index}}" data-field="body" bindinput="edit" /></label>
      <label class="field">讲者备注<textarea class="textarea compact" disabled="{{deck.pipeline === 2 && deck.phase === 'full' && index < 5}}" maxlength="8000" value="{{item.notes}}" data-index="{{index}}" data-field="notes" bindinput="edit" /></label>
    </view>
    <view class="actions"><button class="secondary" loading="{{loading}}" bindtap="save">保存修改</button><button class="primary" loading="{{loading}}" bindtap="generate">确认并生成 PPT →</button></view>
  </view>
  <view wx:else class="section"><text class="hint">正在加载内容...</text></view>
</view>
